    "id": "unique.Usuario.Usuario_cpf_key",
    "label": "Add unique constraint on \"Usuario\" (cpf)",
    "operationClass": "additive",
    "target": {
      "id": "postgres",
      "details": {
        "schema": "public",
        "objectType": "unique",
        "name": "Usuario_cpf_key",
        "table": "Usuario"
      }
    },
    "precheck": [
      {
        "description": "ensure constraint \"Usuario_cpf_key\" does not exist",
        "sql": "SELECT NOT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Usuario_cpf_key",
          "public",
          "\"public\".\"Usuario\""
        ]
      }
    ],
    "execute": [
      {
        "description": "add unique constraint \"Usuario_cpf_key\"",
        "sql": "ALTER TABLE \"public\".\"Usuario\" ADD CONSTRAINT \"Usuario_cpf_key\" UNIQUE (\"cpf\")"
      }
    ],
    "postcheck": [
      {
        "description": "verify constraint \"Usuario_cpf_key\" exists",
        "sql": "SELECT EXISTS (SELECT 1 AS \"one\" FROM \"pg_constraint\" AS \"c\" INNER JOIN \"pg_namespace\" AS \"n\" ON \"n\".\"oid\" = \"c\".\"connamespace\" WHERE (\"c\".\"conname\" = $1 AND \"n\".\"nspname\" = $2 AND \"c\".\"conrelid\" = to_regclass($3))) AS \"result\"",
        "params": [
          "Usuario_cpf_key",
